relationship: part_of UBERON:0001027 ! sensory nerve
property_value: curator_notes "this class and subclasses may be ceded to GO" xsd:string

[Term]
id: UBERON:0012456
name: Merkel nerve ending
def: "Mechanoreceptors found in the skin and mucosa of vertebrates that provide touch information to the brain. The information they provide are those regarding pressure and texture. Each ending consists of a Merkel cell in close apposition with an enlarged nerve terminal." [Wikipedia:Merkel_nerve_ending]
subset: human_subset
subset: mouse_subset
synonym: "Merkel's disc" EXACT [FMA:83606]
synonym: "Merkel's disk" EXACT []
