xref: SCTID:278100005
xref: Wikipedia:Middle_meningeal_artery
is_a: UBERON:0003474 ! meningeal artery
relationship: connecting_branch_of UBERON:0001616 {source="FMA"} ! maxillary artery
property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/1/1e/Middle_meningeal_artery.png" xsd:anyURI

