id: UBERON:0003254
name: amniotic ectoderm
alt_id: UBERON:0008359
subset: human_reference_atlas
subset: human_subset
subset: mouse_subset
synonym: "amnion ectoderm" EXACT [EHDAA2:0000117, OBOL:automatic]
