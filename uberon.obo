id: dc-contributor
name: contributor
xref: http://purl.org/dc/terms/contributor
is_metadata_tag: true

[Typedef]
id: dc-creator
name: creator
xref: http://purl.org/dc/elements/1.1/creator
is_metadata_tag: true

