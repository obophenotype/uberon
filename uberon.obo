xref: EHDAA:1005
xref: EMAPA:16739
xref: NCIT:C34198
xref: RETIRED_EHDAA2:0000909
xref: SCTID:361426003
xref: UMLS:C1283960 {source="ncithesaurus:Laryngotracheal_Tube"}
xref: VHOG:0001404
xref: Wikipedia:Laryngotracheal_groove
