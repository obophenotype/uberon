created_by: dragon-ai-agent

[Term]
id: UBERON:8930197
name: spleen subcapsular zone
def: "An anatomical compartment that lies immediately beneath the fibrous capsule of the spleen containing supporting connective tissue, blood vessels, and early-arriving lymphocytes or immune cells before they migrate into the organ parenchyma." [doi:10.1111/j.1365-2249.2008.03734.x]
subset: added_by_HRA
subset: human_subset
subset: mouse_subset
is_a: UBERON:0000064 ! organ part
relationship: dc-contributor https://orcid.org/0000-0002-2999-0103
relationship: part_of UBERON:0002106 ! spleen
relationship: present_in_taxon NCBITaxon:9606 ! Homo sapiens
