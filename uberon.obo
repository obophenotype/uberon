property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/8/82/Stomach_colon_rectum_diagram.svg" xsd:anyURI
property_value: depiction "https://cdn.humanatlas.io/digital-objects/ref-organ/large-intestine-female/v1.3/assets/3d-sbu-f-large-intestine.glb" xsd:anyURI
