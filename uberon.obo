property_value: term_tracker_item "https://github.com/obophenotype/uberon/pull/3722" xsd:anyURI
created_by: dragon-ai-agent

[Term]
id: UBERON:8930198
name: superficial mantle zone
def: "A lymphoid tissue zone forming the outermost layer of the spleen B cell corona, distal to the germinal center, that predominantly harbors naive and small resting B lymphocytes." [doi:10.1111/imm.12469]
subset: added_by_HRA
subset: human_subset
subset: mouse_subset
