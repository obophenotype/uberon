relationship: capable_of GO:0006590 ! thyroid hormone generation
relationship: has_potential_to_develop_into UBERON:0002046 {gci_relation="part_of", gci_filler="NCBITaxon:117569"} ! thyroid gland
relationship: has_quality PATO:0002255 ! grooved
