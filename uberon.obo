property_value: external_definition "The transparent membrane which surrounds the lens of the eye. [Dorian_AF, Elsevier's_encyclopaedic_dictionary_of_medicine, Part_B:_Anatomy_(1988)_Amsterdam_etc.:_Elsevier][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000550", ontology="VHOG", source="http://bgee.unil.ch/"}
