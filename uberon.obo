relationship: present_in_taxon NCBITaxon:9606 ! Homo sapiens
property_value: dcterms-date "2026-05-25T00:00:00Z" xsd:dateTime

[Term]
id: UBERON:8930043
name: fluid of fallopian tube infundibulum
def: "A bodily fluid that is located in the infundibulum of the fallopian tube, which accumulates in the funnel-shaped opening where the ovulated egg enters the uterine tube." [https://purl.org/ccf/ASCTB-TEMP_fluid-of-fallopian-tube-infundibulum, PMID:25994820]
subset: added_by_HRA
subset: human_subset
subset: mouse_subset
