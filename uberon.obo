relationship: present_in_taxon NCBITaxon:9606 ! Homo sapiens
property_value: dcterms-date "2026-05-25T00:00:00Z" xsd:dateTime

[Term]
id: UBERON:8930044
name: fluid of fallopian tube intramural segment
def: "A bodily fluid that is contained within the lumen of the intramural segment of the fallopian tube, providing a medium for the passage of gametes and early embryos through this narrow tubular portion." [https://purl.org/ccf/ASCTB-TEMP_fluid-of-fallopian-tube-intramural-segment, PMID:16938110]
