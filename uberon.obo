relationship: develops_from UBERON:0010336 {source="EHDAA2"} ! mandibular process mesenchyme from neural crest
relationship: has_developmental_contribution_from UBERON:0003324 {source="EHDAA2-modified"} ! mesenchyme of lower jaw
