xref: SCTID:280526000
xref: Wikipedia:Renal_plexus
is_a: UBERON:0001816 {source="FMA"} ! autonomic nerve plexus

[Term]
id: UBERON:0018679
name: thoracic splanchnic nerve
def: "Thoracic splanchnic nerves are splanchnic nerves that arise from the sympathetic trunk in the thorax and travel inferiorly to provide sympathetic innervation to the abdomen. The nerves contain preganglionic sympathetic and general visceral afferent fibers." [Wikipedia:Thoracic_splanchnic_nerves]
subset: human_reference_atlas
subset: human_subset
subset: mouse_subset
