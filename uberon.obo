xref: FMA:83967
xref: NCIT:C12890
xref: neuronames:1237
xref: SCTID:279275004
xref: UMLS:C0228120 {source="ncithesaurus:Falx_Cerebri"}
xref: Wikipedia:Falx_cerebri
is_a: UBERON:0000064 ! organ part
relationship: develops_from UBERON:0000922 ! embryo
