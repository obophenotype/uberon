property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/d/da/Gray1120.png" xsd:anyURI
property_value: depiction "https://cdn.humanatlas.io/digital-objects/ref-organ/blood-vasculature-female/v1.3/assets/3d-vh-f-blood-vasculature.glb" xsd:anyURI
