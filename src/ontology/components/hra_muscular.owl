AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780323393225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:13129167") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://fipat.library.dal.ca/ta2/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_levatores-costarum-longi-of-levator-costarum-muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_9900031> "A muscle fasciculus that constitutes the longer subdivision of the four lower levatores costarum, arising from the tip of the transverse process of a thoracic vertebra (typically T8-T11) and passing obliquely downward and laterally to insert on the outer surface of the second rib below its vertebra of origin, between the tubercle and the angle.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/UBERON_9900031> "https://github.com/obophenotype/uberon/issues/3707"^^xsd:anyURI)
