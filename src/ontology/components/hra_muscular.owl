    <!-- http://purl.obolibrary.org/obo/UBERON_9900037 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010990"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006072"/>
            </Restriction>
