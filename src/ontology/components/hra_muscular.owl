                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013647"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004649"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002373"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004657"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A muscle head that is the larger, lower division of the lateral pterygoid muscle, arising from the lateral surface of the lateral pterygoid plate of the sphenoid bone and inserting onto the pterygoid fovea on the neck of the mandibular condyle; it acts on the inferior compartment of the temporomandibular joint to depress, protrude, and laterally deviate the mandible.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_pterygoid_muscle</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>inferior head of lateral pterygoid muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900018"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A muscle head that is the larger, lower division of the lateral pterygoid muscle, arising from the lateral surface of the lateral pterygoid plate of the sphenoid bone and inserting onto the pterygoid fovea on the neck of the mandibular condyle; it acts on the inferior compartment of the temporomandibular joint to depress, protrude, and laterally deviate the mandible.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12446184</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15104127</oboInOwl:hasDbXref>
