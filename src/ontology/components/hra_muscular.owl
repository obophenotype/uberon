    <!-- http://purl.obolibrary.org/obo/UBERON_9900001 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014892"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006072"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001780"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002413"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002373"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002413"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal muscle organ that is one of a paired series of short segmental muscles connecting the anterior tubercles of adjacent cervical vertebrae, lying anterior to the ventral rami of the cervical spinal nerves and acting to bend the cervical spine laterally.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>Wikipedia:Intertransversarii</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>anterior cervical intertransversarii muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900001"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A skeletal muscle organ that is one of a paired series of short segmental muscles connecting the anterior tubercles of adjacent cervical vertebrae, lying anterior to the ventral rami of the cervical spinal nerves and acting to bend the cervical spine laterally.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:7076562</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://purl.org/ccf/ASCTB-TEMP_anterior-cervical-intertransversarii-muscle</oboInOwl:hasDbXref>
    </Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_9900003 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001267"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000981"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A small skeletal muscle organ of the anterior thigh, lying deep to the vastus intermedius, that arises from the anterior surface of the distal shaft of the femur and inserts onto the proximal wall of the suprapatellar bursa and the synovial membrane of the knee joint, where it retracts the bursa superiorly during knee extension.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>FMA:22424</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Articularis_genus_muscle</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>articularis genu muscle</rdfs:label>
        <foaf:depiction>https://upload.wikimedia.org/wikipedia/commons/2/2b/Gray244.png</foaf:depiction>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900003"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A small skeletal muscle organ of the anterior thigh, lying deep to the vastus intermedius, that arises from the anterior surface of the distal shaft of the femur and inserts onto the proximal wall of the suprapatellar bursa and the synovial membrane of the knee joint, where it retracts the bursa superiorly during knee extension.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30229230</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://purl.org/ccf/ASCTB-TEMP_articularis-genu-muscle</oboInOwl:hasDbXref>
    </Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_9900008 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900008">
