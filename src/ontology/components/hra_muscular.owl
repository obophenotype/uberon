    <!-- http://purl.obolibrary.org/obo/UBERON_9900015 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011906"/>
        <rdfs:subClassOf>
