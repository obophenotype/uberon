AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780323393225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:3630603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:4972578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://fipat.library.dal.ca/ta2/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_levatores-costarum-breves-of-levator-costarum-muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_9900030> "Short skeletal muscle fasciculi of the levator costarum muscle that arise from the tips of the transverse processes of the seventh cervical and upper eleven thoracic vertebrae and insert obliquely inferolaterally onto the external aspect of the superior border of the rib immediately below their origin, between the tubercle and the angle, elevating the ribs during forceful inspiration.")
