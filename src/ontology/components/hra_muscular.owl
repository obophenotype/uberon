                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034983"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002373"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000981"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A muscle head that originates from the ischial tuberosity and descends almost vertically through the posterior compartment of the thigh to insert by a rounded tendon onto the adductor tubercle of the medial femoral condyle. It is the ischiocondylar division of the adductor magnus, is innervated by the tibial division of the sciatic nerve, and acts to extend the hip joint.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>Wikipedia:Adductor_magnus_muscle</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>hamstring portion of adductor magnus muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900015"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A muscle head that originates from the ischial tuberosity and descends almost vertically through the posterior compartment of the thigh to insert by a rounded tendon onto the adductor tubercle of the medial femoral condyle. It is the ischiocondylar division of the adductor magnus, is innervated by the tibial division of the sciatic nerve, and acts to extend the hip joint.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:23813615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://purl.org/ccf/ASCTB-TEMP_hamstring-portion-of-adductor-magnus-muscle</oboInOwl:hasDbXref>
    </Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_9900018 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011906"/>
        <rdfs:subClassOf>
