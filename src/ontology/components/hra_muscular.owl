                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003726"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001105"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002373"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000976"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A muscle head that forms the superior portion of the pectoralis major, originating from the anterior surface of the medial half of the clavicle and converging with the sternocostal head to insert via a common tendon onto the lateral lip of the intertubercular groove of the humerus.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>FMA:32519</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pectoralis_major_muscle</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>clavicular head of pectoralis major muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900008"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A muscle head that forms the superior portion of the pectoralis major, originating from the anterior surface of the medial half of the clavicle and converging with the sternocostal head to insert via a common tendon onto the lateral lip of the intertubercular groove of the humerus.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
