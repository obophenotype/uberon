    <!-- http://purl.obolibrary.org/obo/UBERON_9900025 -->

    <Class rdf:about="http://purl.obolibrary.org/obo/UBERON_9900025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014892"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000978"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035526"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001446"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal muscle organ that is part of the lateral (fibular) fascial compartment of the leg, comprising the fibularis longus and fibularis brevis muscles, both arising from the lateral surface of the fibula and innervated by the superficial fibular nerve, acting to evert and weakly plantarflex the foot.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>Wikipedia:Lateral_compartment_of_leg</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>lateral compartment of leg muscle</rdfs:label>
    </Class>
    <Axiom>
