# Class: <http://purl.obolibrary.org/obo/UBERON_9900008> (clavicular head of pectoralis major muscle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780323393225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Pectoralis_major_muscle") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://fipat.library.dal.ca/ta2/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_clavicular-head-of-pectoralis-major-muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_9900008> "A muscle head that forms the superior portion of the pectoralis major, originating from the anterior surface of the medial half of the clavicle and converging with the sternocostal head to insert via a common tendon onto the lateral lip of the intertubercular groove of the humerus.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/UBERON_9900008> "https://github.com/obophenotype/uberon/issues/3707"^^xsd:anyURI)
