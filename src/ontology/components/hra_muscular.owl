# Class: <http://purl.obolibrary.org/obo/UBERON_9900001> (anterior cervical intertransversarii muscle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780323393225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7076562") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://fipat.library.dal.ca/ta2/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_anterior-cervical-intertransversarii-muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_9900001> "A skeletal muscle organ that is one of a paired series of short segmental muscles connecting the anterior tubercles of adjacent cervical vertebrae, lying anterior to the ventral rami of the cervical spinal nerves and acting to bend the cervical spine laterally.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/UBERON_9900001> "https://github.com/obophenotype/uberon/issues/3707"^^xsd:anyURI)
