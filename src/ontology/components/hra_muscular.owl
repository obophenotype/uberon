AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780323393225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30855894") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://fipat.library.dal.ca/ta2/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_thoracic-wall-muscle") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_9900068> "A group of skeletal muscles that are part of the thoracic wall and act on the ribs to produce respiratory movements, comprising the external, internal and innermost intercostals, subcostales and transversus thoracis.")
