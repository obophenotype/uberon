        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>external ear muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900013"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A group of skeletal muscles attached to the auricular cartilage that act to move the pinna, comprising the auricularis anterior, auricularis superior, and auricularis posterior.</annotatedTarget>
