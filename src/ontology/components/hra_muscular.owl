                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002228"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Short skeletal muscle fasciculi of the levator costarum muscle that arise from the tips of the transverse processes of the seventh cervical and upper eleven thoracic vertebrae and insert obliquely inferolaterally onto the external aspect of the superior border of the rib immediately below their origin, between the tubercle and the angle, elevating the ribs during forceful inspiration.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
