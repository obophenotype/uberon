                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002005"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006839"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002372"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001077"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002373"/>
                <someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001076"/>
            </Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal muscle of the deep layer of the back, forming the cervical portion of the multifidus and part of the transversospinales muscle group. It arises from the superior articular processes of the lower cervical vertebrae (C4-C7) and ascends superomedially to insert into the spinous processes of vertebrae two to five segments above (C2-C5), acting in extension, ipsilateral lateral flexion and contralateral rotation of the cervical vertebral column.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3707</obo:IAO_0000233>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-11T00:00:00Z</terms:date>
        <oboInOwl:hasDbXref>Wikipedia:Multifidus_muscle</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:label>multifidus cervicis muscle</rdfs:label>
    </Class>
    <Axiom>
        <annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_9900037"/>
        <annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <annotatedTarget>A skeletal muscle of the deep layer of the back, forming the cervical portion of the multifidus and part of the transversospinales muscle group. It arises from the superior articular processes of the lower cervical vertebrae (C4-C7) and ascends superomedially to insert into the spinous processes of vertebrae two to five segments above (C2-C5), acting in extension, ipsilateral lateral flexion and contralateral rotation of the cervical vertebral column.</annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15706328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://purl.org/ccf/ASCTB-TEMP_multifidus-cervicis-muscle</oboInOwl:hasDbXref>
    </Axiom>
    


