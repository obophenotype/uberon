# Class: <http://purl.obolibrary.org/obo/UBERON_8930002> (alveolar capillary)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27981379") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34499087") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1152/japplphysiol.01177.2009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_alveolar-capillary") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8930002> "A capillary that is part of the alveolar wall and participates in the blood-gas barrier, facilitating gas exchange between the alveolar air space and the blood. Alveolar capillaries form an extensive network around the pulmonary alveoli, where oxygen diffuses from the alveolar air into the blood and carbon dioxide diffuses from the blood into the alveolar air.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/UBERON_8930002> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/UBERON_8930002> <https://orcid.org/0000-0002-2999-0103>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/UBERON_8930002> "2026-05-25T00:00:00Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_8930002> "Wikipedia:Pulmonary_alveolus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_8930002> <http://purl.obolibrary.org/obo/uberon/core#added_by_HRA>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_8930002> "alveolar capillary")
AnnotationAssertion(<http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/UBERON_8930002> "https://upload.wikimedia.org/wikipedia/commons/4/46/Alveolus_diagram.svg")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_8930002> <http://purl.obolibrary.org/obo/UBERON_0001982>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_8930002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0002299>))

