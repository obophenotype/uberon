AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41554560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Posterior_superior_alveolar_artery") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_alveolar-mucosa-capillary") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8930003> "A capillary that is part of the alveolar mucosa and contributes to the vascular plexus providing nutrition to the oral mucosa lining between the buccal and labial mucosae.")
