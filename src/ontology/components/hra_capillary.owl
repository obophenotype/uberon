AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:941854") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://basicmedicalkey.com/endocrine-system-3/") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_capillary-plexus-of-posterior-pituitary-gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8930008> "A capillary plexus that forms a dense vascular network in the posterior pituitary gland, receiving secreted neurohypophysial hormones (oxytocin and vasopressin) from axon terminals of hypothalamic neurons for distribution into systemic circulation.")
