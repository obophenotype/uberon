# Class: <http://purl.obolibrary.org/obo/UBERON_8930009> (parotid gland capillary)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41860412") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_deep-parotid-gland-capillary") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://purl.org/ccf/ASCTB-TEMP_superior-parotid-gland-capillary") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_8930009> "A capillary that is part of the parotid gland, forming part of the microvascular network that supplies blood to the glandular parenchyma and facilitates exchange between blood and the secretory acini.")
