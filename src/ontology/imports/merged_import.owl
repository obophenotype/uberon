SubClassOf(<http://purl.obolibrary.org/obo/GO_0048486> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0048483>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048486> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7742>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048486> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0000011>))

