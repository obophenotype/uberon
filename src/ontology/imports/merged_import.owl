AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19129259") rdfs:comment <http://purl.obolibrary.org/obo/CL_1001033> "Peritubular capillary endothelial cells feature fenestrations measuring 60-70 nm in diameter, each traversed by a thin diaphragm.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_1001033> "peritubular capillary endothelial cell")
