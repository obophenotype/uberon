AnnotationAssertion(Annotation(rdfs:label "tuft cell of colon on CELLxGENE CellGuide") rdfs:seeAlso <http://purl.obolibrary.org/obo/CL_0009041> "https://cellxgene.cziscience.com/cellguide/CL_0009041")
