AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0002072> "optic cup morphogenesis involved in camera-type eye development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0002072> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0009653> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002298> <http://purl.obolibrary.org/obo/UBERON_0003072>)))
