AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20683682") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_4047017> "TA cell")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4047017> "transit amplifying cell of gut"@en)
