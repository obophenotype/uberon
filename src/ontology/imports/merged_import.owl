SubClassOf(<http://purl.obolibrary.org/obo/GO_0072244> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0072224>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0072244> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7742>))
