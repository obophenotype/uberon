AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25311230") rdfs:comment <http://purl.obolibrary.org/obo/CL_4030032> "Activated valve interstitial cells undergo continual turn over into deactivated fibroblasts and other cell fates (such as apoptosis).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4030032> "valve interstitial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4030032> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_4030031> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000946>)))
