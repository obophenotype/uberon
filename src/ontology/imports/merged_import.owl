AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4033013> "suprabasal keratinocyte")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4033013> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000312> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0010402>)))
