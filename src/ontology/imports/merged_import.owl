# Class: <http://purl.obolibrary.org/obo/CL_4042039> (caudal ganglionic eminence derived neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12593982") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12637172") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20130169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK98190/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4042039> "A neuron of the central nervous system that develops from a caudal ganglionic eminence.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4042039> <https://orcid.org/0000-0002-0098-8958>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4042039> "2024-11-14T11:27:25Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12593982") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12637172") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20130169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/books/NBK98190/") rdfs:comment <http://purl.obolibrary.org/obo/CL_4042039> "Neurons derived from the caudal ganglionic eminence consist mostly of neurons populating the cortical layers of the brain and some subcortical areas such as the globus pallidus, the striatus and the hippocampus. Amongst neurons derived from the caudal ganglionic eminence there are cortical GABAergic neurons such as Pax6, Lamp5, VIP, sncg, GABAergic; in the hippocampus, mossy fibers, pyramidal neurons, granule neurons and interneurons; in the striatum and globus pallidus, medium spiny projection neurons.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4042039> "caudal ganglionic eminence derived neuron"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4042039> <http://purl.obolibrary.org/obo/BFO_0000002>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4042039> <http://purl.obolibrary.org/obo/CL_2000029>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4042039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0004026>))

# Class: <http://purl.obolibrary.org/obo/CL_4047017> (transit amplifying cell of gut)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20683682") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33195268") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34497389") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4047017> "A transit amplifying cell of the gut epithelium, located in the wall of the intestinal crypt, just above intestinal stem cells from which they derive. These are rapidly dividing cells, capable of multiple rounds of division before differentiating into the various cell types of the gut epithelium (enterocyte, goblet, eneterodendocrine, paneth cells).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4047017> <https://orcid.org/0009-0005-7919-4905>)
