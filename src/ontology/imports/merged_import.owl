AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0061373> "mammillary axonal complex development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0061373> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0006695>)))
