SubClassOf(<http://purl.obolibrary.org/obo/CL_4052039> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0003359>))

# Class: <http://purl.obolibrary.org/obo/CL_4052040> (tuft cell of stomach)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22527717") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38117182") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:/10.1101/2022.02.16.480779") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4052040> "A tuft cell that is part of the epithelium of the stomach. This cell is characterized by gastric chemosensation and immune regulation through IL-25 secretion, which activates ILC2s to produce IL-13, driving epithelial remodelling and tuft cell expansion. Unlike intestinal tuft cells, which are primarily involved in helminth defense and type 2 immunity, the tuft cell of the stomach is primarily involved in inflammation, metaplasia, and hyperplasia.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4052040> <https://orcid.org/0009-0000-8480-9277>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4052040> "2025-02-12T11:24:56Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38117182") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052040> "gastric tuft cell")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4052040> "tuft cell of stomach")
