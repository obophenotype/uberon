# Class: <http://purl.obolibrary.org/obo/CL_0020021> (fibrochondrocyte progenitor cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31871141") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36338137") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0020021> "A mesenchymal progenitor cell located in fibrocartilaginous tissues, along the fibrochondrocytic differentiation pathway that co-expresses both fibrochondrocyte markers (COL1A1, COL3A1) and mesenchymal stem cell markers (MCAM/CD146, MYLK) in humans. This cell serves as a progenitor for mature fibrochondrocytes and other meniscal cell types, with differentiation regulated by TGF-β signaling, focal adhesion, and extracellular matrix-receptor interaction pathways.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_0020021> <https://orcid.org/0009-0000-8480-9277>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31871141") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020021> "FCP")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31871141") rdfs:comment <http://purl.obolibrary.org/obo/CL_0020021> "A fibrochondrocyte progenitor cell demonstrates colony-forming capacity and multi-lineage differentiation potential toward osteogenic and adipogenic lineages.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0020021> "fibrochondrocyte progenitor cell")
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020021> <http://purl.obolibrary.org/obo/CL_0002320>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020021> <http://purl.obolibrary.org/obo/CL_0008019>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020021> <http://purl.obolibrary.org/obo/CL_0011026>)
