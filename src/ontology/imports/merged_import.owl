# Class: <http://purl.obolibrary.org/obo/CL_0002395> (Gr1-high classical monocyte)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:tfm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20628149") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27098205") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8890901") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.immgen.org/index_content.html") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0002395> "A resident monocyte that is Gr-1 high, CD43-negative, CX3CR1-negative, CD115-positive, and B220-negative.")
