# Class: <http://purl.obolibrary.org/obo/PATO_0002317> (parallelogram)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "wikipedia:Parallelogram") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002317> "A convex quadrilateral is a parallelogram if and only if any one of the following statements are true:
1. Each diagonal divides the quadrilateral into two congruent triangles with the same orientation.
2. The opposite sides are congruent in pairs.
3. The diagonals bisect each other.
4. The opposite angles are congruent in pairs.
5. The sum of the squares of the sides equals the sum of the squares of the diagonals. (This is the parallelogram law)
6.It possesses rotational symmetry.
7.One pair of opposite sides are parallel and congruent.
8.Two pairs of adjacent angles are supplementary.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PATO_0002317> <https://orcid.org/0000-0002-2061-091X>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/PATO_0002317> "2011-10-12T12:33:07Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PATO_0002317> "PATO:0002317")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PATO_0002317> <http://purl.obolibrary.org/obo/pato#value_slim>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0002317> "parallelogram")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0002317> <http://purl.obolibrary.org/obo/PATO_0001988>)

# Class: <http://purl.obolibrary.org/obo/PATO_0002318> (superelliptic)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "wiktionary:superellipse") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0002318> "A shape constituting a transition between a rectangle and a circle; a closed curve, of which the circle and ellipse are special cases, whose parametric equation is x = a.cos2/rt, y = b.cos2/rt")
