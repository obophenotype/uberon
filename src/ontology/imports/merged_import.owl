SubClassOf(<http://purl.obolibrary.org/obo/GO_0048240> <http://purl.obolibrary.org/obo/GO_0048469>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048240> ObjectComplementOf(ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_4751>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048240> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0007286>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048240> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_2759>))

