# Class: <http://purl.obolibrary.org/obo/CL_2000027> (cerebellar basket cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32990595") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8915580") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_2000027> "A GABAergic inhibitory interneuron located in the molecular layer of the cerebellar cortex. It projects axons that form specialized synaptic structures around Purkinje cells, including pericellular baskets, which wrap around the Purkinje cell soma, and the pinceau: a brush-like terminal that contacts the initial segment of the Purkinje cell axon. The basket cell modulates Purkinje cell activity through both chemical (GABAergic) and non-synaptic (ephaptic) mechanisms. It is arranged in sagittal rows that align with Purkinje cell zones, contributing to the cerebellum's modular and topographically organized architecture. It plays an essential role in regulating motor coordination and potentially cognitive functions.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_2000027> <http://www.wikidata.org/entity/Q35563349>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/CL_2000027> "2014-06-25T00:24:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_2000027> "cerebellum basket cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CL_2000027> "CL:2000027")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_2000027> "cerebellar basket cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_2000027> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000118> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002100> <http://purl.obolibrary.org/obo/UBERON_0002037>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_2000027> <http://purl.obolibrary.org/obo/CL_0000118>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_2000027> <http://purl.obolibrary.org/obo/CL_4042035>)

