# Class: <http://purl.obolibrary.org/obo/CL_4047037> (stomach smooth muscle inner oblique layer cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29493959") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4047037> "A smooth muscle cell found in the innermost layer of the muscularis externa of the stomach wall. This cell forms a unique layer of smooth muscle fibers oriented obliquely to the stomach's longitudinal axis. It is responsible for aiding in the mixing and churning of gastric contents, contributing to mechanical digestion within the stomach.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4047037> <https://orcid.org/0009-0005-7919-4905>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4047037> "2024-12-09T10:53:19Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4047037> "stomach smooth muscle oblique layer cell")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4047037> "stomach smooth muscle inner oblique layer cell"@en)
