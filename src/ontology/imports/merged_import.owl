AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001018> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001018> "CD3 subunit with immunoglobulin domain")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001018> <http://purl.obolibrary.org/obo/PR_000000001>)

