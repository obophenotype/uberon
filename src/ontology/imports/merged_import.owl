SubClassOf(<http://purl.obolibrary.org/obo/GO_0021695> <http://purl.obolibrary.org/obo/GO_0160108>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021695> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0021549>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021695> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7742>))
