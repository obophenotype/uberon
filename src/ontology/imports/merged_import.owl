SubClassOf(<http://purl.obolibrary.org/obo/GO_0035270> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0000949>))

# Class: <http://purl.obolibrary.org/obo/GO_0035272> (exocrine system development)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Exocrine_gland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0035272> "Progression of the exocrine system over time, from its formation to a mature structure. The exocrine system is a system of hormones and glands, where the glands secrete straight to a target site via ducts or tubes. The human exocrine system includes the salivary glands, sweat glands and many glands of the digestive system.")
