# Class: <http://purl.obolibrary.org/obo/CL_0020059> (serous demilune cell of salivary gland)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41686279") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0020059> "A serous secreting cell that is part of a salivary gland, forming crescent-shaped (demilune) caps at the distal ends of mucous acini in mixed glands. Prominent in human submandibular and sublingual glands, this cell delivers its watery, enzyme-rich secretions including alpha-amylase through intercellular canaliculi that run between adjacent mucous cells to reach the acinar lumen (Amano et al., 2012). In rodents, these cells also express neuronal nitric oxide synthase (nNOS).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/CL_0020059> <https://github.com/obophenotype/cell-ontology/issues/3597>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_0020059> <https://orcid.org/0000-0002-5507-2103>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_0020059> "2026-03-24T10:46:30Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0020059> "serous demilune cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Serous_demilune") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020059> "Crescents of Giannuzzi")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020059> "demilune cell of salivary gland")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020059> "serous crescent cell")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CL_0020059> "The classic crescent-shaped morphology that gives demilune cells their name is a well-established histological feature, but must be caveated with the fixation artifact issue. Amano et al. (2012) describe how rapid-freeze fixation reveals a more tubular arrangement, suggesting the demilune shape is at least partly artifactual.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0020059> "serous demilune cell of salivary gland")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0020059> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000313> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001044>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020059> <http://purl.obolibrary.org/obo/CL_0000152>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020059> <http://purl.obolibrary.org/obo/CL_0000313>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020059> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001044>))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020059> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0046541>))

# Class: <http://purl.obolibrary.org/obo/CL_0020063> (tuft cell of parotid gland)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35993302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098741") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38358561") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0020063> "A tuft cell that is part of the epithelium of the parotid gland, localized to the striated ducts and never observed in acini. This cell is characterized by expression of POU2F3 and is expected to possess chemosensory function consistent with tuft cells in other tissues. Immunohistochemical analysis of normal human parotid gland tissue detected POU2F3-positive cells as a very rare population within the ductal compartment, positioned on the luminal side (Hoki et al., 2024).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/CL_0020063> <https://github.com/obophenotype/cell-ontology/issues/3597>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_0020063> <https://orcid.org/0000-0002-5507-2103>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_0020063> "2026-03-24T10:46:30Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:3284416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38358561") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0020063> "parotid gland tuft cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18062147") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020063> "brush cell of parotid gland")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0020063> "tuft cell of parotid gland")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0020063> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0002204> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001831>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020063> <http://purl.obolibrary.org/obo/CL_0002204>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020063> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001831>))

# Class: <http://purl.obolibrary.org/obo/CL_0020064> (tuft cell of sublingual gland)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38358561") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0020064> "A tuft cell that is part of the epithelium of the sublingual gland, localized to the ductal compartment. This cell is characterized by expression of POU2F3, consistent with tuft cell identity. Immunohistochemical analysis detected POU2F3-positive cells in normal human sublingual gland tissue (Hoki et al., 2024).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/CL_0020064> <https://github.com/obophenotype/cell-ontology/issues/3597>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_0020064> <https://orcid.org/0000-0002-5507-2103>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_0020064> "2026-03-24T10:46:30Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38358561") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8874101") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0020064> "sublingual gland tuft cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18062147") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23209333") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0020064> "brush cell of sublingual gland")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0020064> "tuft cell of sublingual gland")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0020064> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0002204> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001832>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_0020064> <http://purl.obolibrary.org/obo/CL_0002204>)
