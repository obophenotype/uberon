AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006939> "visceral muscle contraction")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006939> "GO:0006939")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006939> "smooth muscle contraction")
