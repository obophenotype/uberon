AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0323025781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UBERON:0001705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Nail_(anatomy)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0035878> "The process whose specific outcome is the progression of a nail over time, from its formation to the mature structure. A nail is a horn-like envelope covering the outer end of a finger or toe, and consists of the nail plate, the nail matrix and the nail bed below it, and the grooves surrounding it.")
