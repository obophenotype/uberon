AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0035317> "See also the fly_anatomy.ontology term 'wing hair ; FBbt:00004340'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0035317> "imaginal disc-derived wing hair organization")
