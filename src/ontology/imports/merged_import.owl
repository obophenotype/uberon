# Class: <http://purl.obolibrary.org/obo/GO_0001922> (B-1 B cell homeostasis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:add") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0781735149") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0001922> "The process of regulating the proliferation and elimination of B cells of the B-1 subset such that the total number of B-1 B cells within a whole or part of an organism is stable over time in the absence of an outside stimulus. B-1 B cells are a distinct subset of B cells characterized as being CD5 positive, found predominantly in the peritoneum, pleural cavities, and spleen, and enriched for self-reactivity.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001922> "B-1 B lymphocyte homeostasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001922> "B-1 B-cell homeostasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001922> "B-1 B-lymphocyte homeostasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0001922> "GO:0001922")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0001922> "Note that this term represents the return of B-1 B cell levels to stable numbers following an immune response, as well as the proliferation and elimination of B-1 B cells in a organism required to maintain stable numbers in the absence of an outside stimulus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0001922> "B-1 B cell homeostasis")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0001922> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048872> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0012003> <http://purl.obolibrary.org/obo/CL_0000819>)))
