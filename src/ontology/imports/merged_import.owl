AnnotationAssertion(Annotation(rdfs:label "respiratory tract multiciliated cell on CELLxGENE CellGuide") rdfs:seeAlso <http://purl.obolibrary.org/obo/CL_4030034> "https://cellxgene.cziscience.com/cellguide/CL_4030034")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4030034> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000075> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0004802>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <http://purl.obolibrary.org/obo/GO_0031514>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/PATO_0010007>)))
