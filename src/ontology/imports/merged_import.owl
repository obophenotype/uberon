AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38548667") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052042> "urethral cholinergic chemosensory cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38548667") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052042> "urethral tuft cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27680547") rdfs:comment <http://purl.obolibrary.org/obo/CL_4052042> "Urethral tuft cells are heterogeneous, with both cholinergic and non-cholinergic populations present.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4052042> "tuft cell of urethra")
