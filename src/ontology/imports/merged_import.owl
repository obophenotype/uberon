AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Animal_echolocation") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0050959> "biological sonar")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0050959> "perception of environment using reflected sound waves")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0050959> "GO:0050959")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0050959> "echolocation")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0050959> <http://purl.obolibrary.org/obo/GO_0050877>)
