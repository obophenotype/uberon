AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/RO_0040036> <https://orcid.org/0000-0002-6601-2165>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/RO_0040036> "2018-09-26T01:08:58Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0040036> "results in changes to anatomical or cellular structure")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0040036> <http://purl.obolibrary.org/obo/RO_0000057>)

