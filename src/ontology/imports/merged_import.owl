AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006941> "sarcomeric muscle contraction")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006941> "GO:0006941")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006941> "striated muscle contraction")
