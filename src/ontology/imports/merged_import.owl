AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_0000125> "neuroglia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CL_0000125> <http://purl.obolibrary.org/obo/cl#cellxgene_subset>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CL_0000125> <http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CL_0000125> "Not all glial cells develop from glioblasts, with microglia developing from the mesoderm instead. See https://github.com/obophenotype/cell-ontology/issues/1571")
