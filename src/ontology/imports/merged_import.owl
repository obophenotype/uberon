AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001005> "integrin alpha with I domain")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000001005> "PR:000001005")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001005> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001005> "integrin alpha with A domain")
