AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000021") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0021620> "The process that gives rise to the hypoglossal nerve. This process pertains to the initial formation of a structure from unspecified parts. This motor nerve innervates all the intrinsic and all but one of the extrinsic muscles of the tongue.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0021620> "CN XII biosynthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0021620> "CN XII formation")
