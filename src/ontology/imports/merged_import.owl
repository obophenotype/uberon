SubClassOf(<http://purl.obolibrary.org/obo/GO_0048898> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7711>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0048898> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_2001468>))

