AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CL_0000202> "In mammals these cells are located in the organ of Corti.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000202> "auditory hair cell")
