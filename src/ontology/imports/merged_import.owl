AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0048909> "rostral lateral line nerve development")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0048909> "GO:0048909")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0048909> "anterior lateral line nerve development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0048909> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_2000425>)))
