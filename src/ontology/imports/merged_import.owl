AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/GO_0036064> <http://purl.obolibrary.org/obo/NCBITaxon_4890>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/GO_0036064> <http://purl.obolibrary.org/obo/NCBITaxon_5782>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/GO_0036064> <http://purl.obolibrary.org/obo/NCBITaxon_58019>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/GO_0036064> "bf")
