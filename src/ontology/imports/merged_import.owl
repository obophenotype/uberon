# Class: <http://purl.obolibrary.org/obo/CL_4052022> (fallopian tube smooth muscle cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31183831") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31613440") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4052022> "A smooth muscle cell that is part of the fallopian tube. This cell is responsible for peristaltic contractions that facilitate gamete and embryo transport, fluid mixing, and embryo admission to the uterus.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4052022> <https://orcid.org/0009-0000-8480-9277>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4052022> "2024-10-21T12:16:54Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31613440") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/CL_4052022> "oviduct smooth muscle cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31613440") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052022> "uterine tube smooth muscle cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18621753") rdfs:comment <http://purl.obolibrary.org/obo/CL_4052022> "The fallopian tube smooth muscle cell in the human contracts dynamically in response to hormones and signaling molecules. Prostaglandins, particularly PGF2α and PGE2, have been shown to increase muscular contractions, while progesterone, levonorgestrel, mifepristone, oxytocin, and human chorionic gonadotropin (hCG) decrease them. These contractile responses are crucial for regulating gamete and embryo transport through the fallopian tube.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4052022> "fallopian tube smooth muscle cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4052022> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000192> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0003889>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_4052022> <http://purl.obolibrary.org/obo/CL_0000192>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4052022> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0003889>))

# Class: <http://purl.obolibrary.org/obo/CL_4052023> (luminal endometrial unciliated epithelial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32929266") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36581776") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38559249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39198675") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4052023> "An epithelial cell that is part of the endometrial luminal epithelium, forming a continuous layer lining the uterine cavity. This cell undergoes cyclical changes during the menstrual cycle, proliferating under estrogen in the proliferative phase, and differentiating under progesterone in the secretory phase to prepare for potential implantation. During the window of implantation, this cell changes from a tall columnar shape to a shorter columnar or cuboidal form, loses polarity, and becomes receptive to blastocyst implantation.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4052023> <https://orcid.org/0009-0000-8480-9277>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4052023> "2024-10-22T12:02:23Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39198675") rdfs:comment <http://purl.obolibrary.org/obo/CL_4052023> "The luminal endometrial unciliated epithelial cell expresses WNT7A, and LGR5 during the proliferative phase, transitioning to express VTCN1 and SULT1E1 in the early secretory phase, and LEFTY1, IL6, and PTGS1 in the mid- to late-secretory phases.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4052023> "luminal endometrial unciliated epithelial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4052023> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000066> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0011949>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0032940>)))
SubClassOf(<http://purl.obolibrary.org/obo/CL_4052023> <http://purl.obolibrary.org/obo/CL_1001591>)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4052023> <http://purl.obolibrary.org/obo/CL_4052050>)

# Class: <http://purl.obolibrary.org/obo/CL_4052025> (neuromuscular junction nucleus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33037211") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33311457") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33311464") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4052025> "A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4052025> <https://orcid.org/0009-0000-8480-9277>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/CL_4052025> <https://orcid.org/0009-0001-6947-615X>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/CL_4052025> "2024-10-31T11:09:04Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33311464") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052025> "neuromuscular junction myonuclei")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33311457") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4052025> "neuromuscular junction nuclei")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CL_4052025> "NMJ nuclues")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CL_4052025> <http://purl.obolibrary.org/obo/cl#cellxgene_subset>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4052025> "neuromuscular junction nucleus")
