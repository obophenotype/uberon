[Term]
id: UBERON:6000000
name: obsolete embryonic germ layer derivative
is_obsolete: true
consider: FBbt:00000000

[Term]
id: UBERON:6000002
name: arthropod tagma
def: "One of the main divisions of the whole organism of arthropods formed from groups of segments." [doi:10.1016/B978-0-12-385026-3.00024-3]
comment: Strictly speaking the term "tagma" cam be used for any metameric organism, however we follow the common usage which is to restrict the term to arthropods.
is_a: UBERON:0011676 ! subdivision of organism along main body axis
relationship: in_taxon NCBITaxon:6656 ! Arthropoda
relationship: never_in_taxon NCBITaxon:7742 ! Vertebrata <vertebrates>
relationship: part_of UBERON:0000468 ! multicellular organism

[Term]
id: UBERON:6000004
name: panarthropod head
intersection_of: UBERON:0000033 ! head
intersection_of: part_of NCBITaxon:88770 ! Panarthropoda

[Term]
id: UBERON:6000005
name: insect ocular segment
def: "Head segment derived from the second embryonic segment (between the labral and antennal segments). In the larva, this segment includes Bolwig's organ." [FlyBase:FBrf0055841, FlyBase:FBrf0075072]
synonym: "acron" RELATED []
is_a: UBERON:6000007 ! procephalic segment
relationship: in_taxon NCBITaxon:50557 {source="cjm"} ! Insecta
relationship: never_in_taxon NCBITaxon:7742 ! Vertebrata <vertebrates>

[Term]
id: UBERON:6000006
name: insect head segment
def: "Any segment that is part of some insect head." [UBERON:cjm]
intersection_of: UBERON:0000914 ! organismal segment
intersection_of: part_of UBERON:0000033 ! head
relationship: never_in_taxon NCBITaxon:7742 ! Vertebrata <vertebrates>

[Term]
id: UBERON:6000007
name: procephalic segment
def: "A segment that is anterior to the gnathal segments." [FBC:gg]
synonym: "cephalic segment" RELATED []
synonym: "pregnathal segment" EXACT []
synonym: "preoral segment" EXACT []
synonym: "procephalon" RELATED []
is_a: UBERON:6000006 ! insect head segment
relationship: never_in_taxon NCBITaxon:7742 ! Vertebrata <vertebrates>
relationship: part_of UBERON:0000033 ! head

[Term]
id: UBERON:6000008
name: labral segment
def: "Procephalic segment anterior to the antennal segment. In the adult it bears the clypeo-labrum." [FlyBase:FBrf0075072, FlyBase:FBrf0089570]
synonym: "clypeo-labrum" RELATED []
is_a: UBERON:6000007 ! procephalic segment

[Term]
id: UBERON:6000009
name: antennal segment
def: "Segment anterior to the intercalary segment. In the adult it bears the antennae." [https://orcid.org/0000-0002-7073-9172]
is_a: UBERON:6000007 ! procephalic segment

[Term]
id: UBERON:6000011
name: insect gnathal segment
def: "The head segments that develop posterior to the embryonic/larval mouth." [FBC:gg]
synonym: "postoral segment" RELATED []
is_a: UBERON:6000006 ! insect head segment
relationship: part_of UBERON:0000033 ! head

[Term]
id: UBERON:6000014
name: insect labial segment
def: "Most posterior of the gnathal segments. In the adult it bears a pair of fused appendages, the labia, and its ectodermal invaginations give rise to the salivary glands." [FlyBase:FBrf0007734]
is_a: UBERON:6000011 ! insect gnathal segment

[Term]
id: UBERON:6000015
name: insect thorax
def: "The main middle section of the insect body comprising three thoracic rings: the pro-, the meso- and the metathoraces which are more or less well fused and cask-like sometimes having on the upper lateral part one of two pairs of wings, while on the ventrolateral part each thoracic ring bears a pair of legs." [FlyBase:FBrf0166419]
is_a: UBERON:6000002 ! arthropod tagma
relationship: in_taxon NCBITaxon:50557 ! Insecta

[Term]
id: UBERON:6000016
name: insect thoracic segment
def: "Any segment (UBERON:6000003) that is part of some thorax (UBERON:6000015)." [FBC:auto_generated_definition]
intersection_of: UBERON:0000914 ! organismal segment
intersection_of: part_of UBERON:6000015 ! insect thorax

[Term]
id: UBERON:6000017
name: insect prothoracic segment
def: "The first (most anterior) segment of the thorax." [https://orcid.org/0000-0002-7073-9172]
synonym: "prothorax" RELATED []
synonym: "t1" RELATED []
synonym: "thoracic segment 1" RELATED []
is_a: UBERON:6000016 ! insect thoracic segment
relationship: part_of UBERON:6000015 ! insect thorax

[Term]
