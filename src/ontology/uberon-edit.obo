is_obsolete: true
replaced_by: UBERON:0009768

[Term]
id: UBERON:0009558
name: pastern bone
def: "A bone that is part of the pastern region of a horse limb. i.e. proximal or middle (P1 or P2) phalanges in digit 3." [http://orcid.org/0000-0002-6601-2165, Wikipedia:Pastern]
xref: Wikipedia:Pastern
