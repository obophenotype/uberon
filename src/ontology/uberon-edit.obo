[Term]
id: UBERON:0004865
name: actinopterygian parietal bone
def: "Dermal bone that covers the otic region and may articulate with its antimere medially, with the frontal bone anteriorly, the pterotic laterally, the supraoccipital medio-posteriorly, and the epiotic and extrascapula latero-posteriorly. The parietal is a paired bone.[TAO]." [TAO:0000486, TAO:GA_TG]
synonym: "actinopterygian parietal" EXACT []
synonym: "frontal bone" NARROW [FMA:52734]
synonym: "parietal bone" NARROW SENSU [TAO:0000486]
synonym: "parietals" RELATED OMO:0003004 [TAO:0000486]
synonym: "post parietal" RELATED [ZFA:0000486]
xref: TAO:0000486
xref: ZFA:0000486
is_a: UBERON:0002514 ! intramembranous bone
relationship: part_of UBERON:0001703 {source="ZFA"} ! neurocranium
relationship: part_of UBERON:0003110 {source="ZFA"} ! otic region
relationship: part_of UBERON:0003113 {source="ZFA"} ! dermatocranium
relationship: part_of UBERON:0004339 {source="PMID:11523816"} ! vault of skull
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps frontal-parietal joint (TAO:0005255)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000486", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps inter-parietal joint (TAO:0005245)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000486", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps posttemporal-parietal joint (TAO:0002059)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000486", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps supraoccipital-parietal joint (TAO:0005264)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000486", ontology="TAO"}
property_value: external_comment "The parietal is a flat, commonly squarish or rectangular bone.[TAO]" xsd:string {date_retrieved="2012-09-06", external_class="TAO:0000486", ontology="TAO", source="Curator"}
property_value: external_definition "Dermal bone that covers the otic region and may articulate with its antimere medially, with the frontal bone anteriorly, the pterotic laterally, the supraoccipital medio-posteriorly, and the epiotic and extrascapula latero-posteriorly. The parietal is a paired bone.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000486", ontology="TAO", source="TAO:GA_TG"}
property_value: homology_notes "The homologization of cranial bones of actinopterygians with those of sarcopterygians based on the bone names established in human anatomy is favored in order to permit the building of phylogenetic relationship schemes beyond the taxonomic boundaries of osteichthyans (including tetrapods). (...) In actinopterygians, the terms parietal and postparietal bones have to replace the commonly used terms 'frontal' and 'parietal' bones for the two paired bones on the skull roof.[well established][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0001327", ontology="VHOG", source="ISBN:978-3899370805 Arratia G, Schultze HP, Wilson MVH, Mesozoic Fishes 4 - Homology and Phylogeny (2008) p.23-48", source="http://bgee.unil.ch/"}

