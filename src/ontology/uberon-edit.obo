id: UBERON:0004866
name: actinopterygian frontal bone
def: "Dermal bone that bears part of the supraorbital canal and usually covers a large area of the neurocranium occupying part of the ethmoidal, orbitosphenoid, and otic regions. Commonly, the frontal bone articulates with its antimere medially, with lateral ethmoid, orbitosphenoid and pterosphenoid ventrolaterally, with supraorbital bone(s), autosphenotic and pterotic laterally, and with parietal posteriorly.[TAO]." [TAO:0000514]
synonym: "actinopterygian frontal" EXACT [TAO:0000514]
synonym: "actinopterygian frontal bone" EXACT [TAO:0000514]
synonym: "frontal bone" NARROW [TAO:0000514]
synonym: "frontals" RELATED OMO:0003004 [TAO:0000514]
xref: TAO:0000514
xref: ZFA:0000514
is_a: UBERON:0008907 {source="ZFA"} ! dermal bone
relationship: overlaps UBERON:0001697 {source="ZFA-modified"} ! orbit of skull
relationship: part_of UBERON:0001703 {source="ZFA"} ! neurocranium
relationship: part_of UBERON:0003113 {source="ZFA"} ! dermatocranium
relationship: part_of UBERON:0004339 {source="PMID:11523816"} ! vault of skull
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps frontal-parietal joint (TAO:0005255)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps frontal-pterotic joint (TAO:0001711)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps inter-frontal joint (TAO:0001922)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps lateral ethmoid-frontal joint (TAO:0002032)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO"}
property_value: axiom_lost_from_external_ontology "relationship loss: overlaps mesethmoid-frontal joint (TAO:0001678)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO"}
property_value: external_comment "The frontal bone may be paired or unpaired. The frontal bone of actinopterygians is homologous to the parietal of tetrapods. Actinopterygians do not have a frontal bone. For details, see Schultze (2008) and Wiley (2008).[TAO]" xsd:string {date_retrieved="2012-09-06", external_class="TAO:0000514", ontology="TAO", source="Curator"}
property_value: external_definition "Dermal bone that bears part of the supraorbital canal and usually covers a large area of the neurocranium occupying part of the ethmoidal, orbitosphenoid, and otic regions. Commonly, the frontal bone articulates with its antimere medially, with lateral ethmoid, orbitosphenoid and pterosphenoid ventrolaterally, with supraorbital bone(s), autosphenotic and pterotic laterally, and with parietal posteriorly.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000514", ontology="TAO", source="ZFIN:curator"}
property_value: taxon_notes "The frontal bone in teleost fish is the homolog of the parietal bone in tetrapods" xsd:string

