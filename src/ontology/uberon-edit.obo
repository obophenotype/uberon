property_value: curator_notes "Subcarinal lymph nodes (station 7) in International Association for the Study of Lung Cancer (IASLC) map coincide with station 2, 8, and 10 lymph nodes in Wang’s map. PMID:26807271" xsd:string
property_value: dcterms-date "2023-05-11T12:12:47Z" xsd:dateTime

