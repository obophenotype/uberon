relationship: never_in_taxon NCBITaxon:8509 {source="Wikipedia"} ! Squamata
relationship: part_of UBERON:0003113 {notes="temporal series", source="ISBN:0073040584"} ! dermatocranium
relationship: part_of UBERON:0003277 {source="AAO"} ! skeleton of upper jaw
property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/e/eb/Skull_synapsida_1.png" xsd:anyURI
property_value: depiction "https://upload.wikimedia.org/wikipedia/commons/6/6e/Archaeopteryx_skull.png" xsd:anyURI
property_value: external_definition "Paired intramembranous bones that completes the maxillary arch posteriorly; they appear at the end of, or just after, metamorphosis[AAO:0000532]." xsd:string {source="AAO:0000532"}

