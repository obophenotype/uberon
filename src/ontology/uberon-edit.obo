synonym: "cervical vertebra 7" EXACT [MA:0001427]
synonym: "prominent vertebra" EXACT [FMA:12525]
synonym: "seventh cervical vertebra" EXACT [FMA:12525]
synonym: "vertebra prominens (CVII)" EXACT [FMA:12525]
synonym: "vertebra prominens [C VII]" EXACT OMO:0003011 [FMA:12525, FMA:TA]
