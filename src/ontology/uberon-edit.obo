synonym: "adenohypophysial pouch" NARROW [EHDAA2:0001588]
synonym: "craniobuccal pouch" RELATED []
synonym: "craniopharyngeal pouch" RELATED []
synonym: "hypophyseal diverticulum" RELATED [https://orcid.org/0000-0002-6601-2165]
synonym: "hypophyseal pouch" RELATED [ISBN:0073040584]
synonym: "nasohypophyseal pouch" RELATED SENSU [http://webs.lander.edu/rsfox/invertebrates/ammocoetes.html]
synonym: "pituitary diverticulum" RELATED [MP:0003817]
synonym: "pouch of Rathke" EXACT []
synonym: "Rathke pouch" EXACT []
