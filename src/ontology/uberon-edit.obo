relationship: dc-contributor https://orcid.org/0000-0002-2825-0621 ! Paola Roncaglia
relationship: has_muscle_insertion UBERON:0002228 ! rib
relationship: has_muscle_origin UBERON:0001077 ! transverse process of vertebra
relationship: present_in_taxon NCBITaxon:9606 ! Homo sapiens
property_value: dcterms-date "2022-01-27T10:41:44Z" xsd:dateTime

