[Term]
id: UBERON:0004681
name: vestibular system
def: "The sensory system for the sense of balance." [NLXANAT:090819]
subset: pheno_slim
synonym: "equilibrioception system" NARROW []
synonym: "vestibular organ system" EXACT [FMA:7193]
