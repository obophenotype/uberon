synonym: "palatopharyngeal sphincter" EXACT [FMA:46684]
synonym: "velopharyngeal sphincter" EXACT [http://medical-dictionary.thefreedictionary.com/velopharyngeal+sphincter]
xref: FMA:46684
xref: SCTID:244801005
is_a: UBERON:0000064 ! organ part
relationship: part_of UBERON:0010234 {source="FMA"} ! palatopharyngeus muscle

