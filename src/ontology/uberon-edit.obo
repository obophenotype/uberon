property_value: dcterms-date "2023-10-24T11:26:27Z" xsd:dateTime

[Term]
id: UBERON:8600025
name: intervillous space
def: "An anatomical space that separates the basal plate and the chorionic plate. The intervillous space is filled with endometrial gland secretions during early stages of the pregnancy and later perfused with maternal blood, bathing the chorionic villous tree." [doi:10.1007/978-3-030-84725-8, PMID:32108320]
is_a: UBERON:0000464 ! anatomical space
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
relationship: part_of UBERON:8600038 ! placental disc
relationship: surrounds UBERON:8600026 ! chorionic villous tree
property_value: dcterms-date "2023-12-12T11:50:32Z" xsd:dateTime

[Term]
id: UBERON:8600026
name: chorionic villous tree
def: "A tree-like structure formed by chorionic villi that sprouts from the chorionic plate in the placental disc. The arborous shape of the chorionic villous tree provides maximal contact area with maternal blood in the intervillous space." [doi:10.1007/978-3-030-84725-8]
synonym: "placental villous tree" EXACT [PMID:9260835]
synonym: "villous tree" BROAD [doi:10.1007/978-3-030-84725-8]
is_a: UBERON:0000061 ! anatomical structure
relationship: composed_primarily_of UBERON:0007106 ! chorionic villus
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
relationship: part_of UBERON:8600038 ! placental disc
relationship: proximally_connected_to UBERON:0004027 ! chorionic plate
property_value: dcterms-date "2023-12-12T11:57:24Z" xsd:dateTime

[Term]
id: UBERON:8600027
name: chorionic stem villus
def: "A chorionic villus that provides structural support to the villous tree. A chorionic stem villus is characterized by a condensed fibrous stroma in which fetal arteries, veins, arterioles, and venules are embedded. It represents a distributing framework for fetal chorionic circulation, supplying the floating villi. It can exhibit a diameter ranging from approximately 3000 μm (trunci near the chorionic plate) to 80 μm (smallest ramuli chorii)." [doi:10.1007/978-3-030-84725-8, PMID:9260835]
synonym: "placental stem villus" EXACT [PMID:9260835]
is_a: UBERON:0007106 ! chorionic villus
relationship: branching_part_of UBERON:8600026 ! chorionic villous tree
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
relationship: develops_from UBERON:8600029 ! chorionic immature intermediate villus
property_value: dcterms-date "2023-12-12T13:00:59Z" xsd:dateTime

[Term]
id: UBERON:8600028
name: chorionic mesenchymal villus
def: "The first generation of a tertiary villus that is derived from a syncytial sprout by the invasion of the mesenchyme, in which blood vessels differentiate through vasculogenesis, and gradually transforms into a new immature intermediate villus. A chorionic mesenchymal villus has a thick trophoblastic covering, and cytotrophoblast cells are interposed between syncytium and the trophoblastic basal lamina over 50–100% of the surface. The stroma is characterized by loosely arranged collagen fibers that enmesh mesenchymal and some villous macrophages. The fetal capillaries are poorly developed." [doi:10.1007/978-3-030-84725-8]
synonym: "mesenchymal villus" BROAD [doi:10.1007/978-3-030-84725-8]
is_a: UBERON:0009995 ! tertiary chorionic villus
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
property_value: dcterms-date "2023-12-12T13:38:12Z" xsd:dateTime

[Term]
id: UBERON:8600029
name: chorionic immature intermediate villus
def: "A bulbous, immature chorionic villus that is formed of loose connective tissue with few fetal vessels. A chorionic immature intermediate villus develops from a chorionic mesenchymal villus, and is the forerunner of a chorionic stem villus." [doi:10.1007/978-3-030-84725-8, PMID:487407, PMID:9260835]
synonym: "immature intermediate villus" RELATED [doi:10.1007/978-3-030-84725-8, PMID:21452443]
is_a: UBERON:0007106 ! chorionic villus
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
relationship: develops_from UBERON:8600028 ! chorionic mesenchymal villus
relationship: develops_into UBERON:8600027 ! chorionic stem villus
property_value: dcterms-date "2023-12-12T13:41:05Z" xsd:dateTime

[Term]
id: UBERON:8600030
name: chorionic terminal villus
def: "The most distal part of a chorionic villus. A chorionic terminal villus is a grape-like structure characterized by a high degree of capillarization and highly dilated sinusoids. A terminal villus has less stroma and a discontinuous cytotrophoblast layer, and contains 4–6 fetal capillaries per cross section. It exhibits a diameter ranging from 40 to about 80 μm." [doi:10.1007/978-3-030-84725-8, PMID:21452443]
synonym: "terminal villus" BROAD [PMID:21452443]
is_a: UBERON:8600032 ! chorionic floating villus
relationship: branching_part_of UBERON:8600026 ! chorionic villous tree
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
property_value: dcterms-date "2023-12-12T13:41:16Z" xsd:dateTime

[Term]
id: UBERON:8600031
name: chorionic mature intermediate villus
def: "A slender branch of a chorionic stem villus. A chorionic mature intermediate villus lacks fetal arterioles and venules in the stroma, which is composed of slender fetal capillaries embedded into a loose connective tissue that is rich in cells but poor in fibers. It exhibits a diameter ranging from 60 to about 100 μm." [doi:10.1007/978-3-030-84725-8, PMID:21452443]
synonym: "mature intermediate villus" BROAD [PMID:21452443]
is_a: UBERON:8600032 ! chorionic floating villus
relationship: branching_part_of UBERON:8600026 ! chorionic villous tree
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
relationship: proximally_connected_to UBERON:8600027 ! chorionic stem villus
property_value: dcterms-date "2023-12-12T13:41:28Z" xsd:dateTime

[Term]
id: UBERON:8600032
name: chorionic floating villus
def: "A chorionic villus that is not attached to the placental basal plate and it is immersed in maternal blood." [doi:10.1007/978-3-030-84725-8, PMID:31870762, PMID:32513715]
synonym: "floating villus" BROAD [PMID:31870762]
synonym: "free-floating villus" BROAD [doi:10.1007/978-3-030-84725-8]
is_a: UBERON:0007106 ! chorionic villus
relationship: branching_part_of UBERON:8600026 ! chorionic villous tree
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
property_value: dcterms-date "2023-12-12T13:42:09Z" xsd:dateTime

[Term]
id: UBERON:8600033
name: chorionic anchoring villus
def: "A distal smaller chorionic stem villus that is connected to the maternal side of the placenta (in early gestational stages to the decidua, and later to the developing basal plate) via a cytotrophoblast cell column. A chorionic anchoring villus stabilizes the position of the villous tree in the maternal intervillous bloodstream." [doi:10.1007/978-3-030-84725-8, PMID:15142834, PMID:32513715, PMID:9260835]
synonym: "anchoring villus" BROAD [PMID:15142834]
is_a: UBERON:8600027 ! chorionic stem villus
relationship: dc-contributor https://orcid.org/0000-0001-6677-8489 ! Aleix Puig-Barbé
property_value: dcterms-date "2023-12-12T13:42:20Z" xsd:dateTime

