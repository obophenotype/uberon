relationship: has_part UBERON:0007106 ! chorionic villus
relationship: part_of UBERON:0002450 ! decidua
property_value: depiction "https://upload.wikimedia.org/wikipedia/commons/3/30/Placental_cotyledon.png" xsd:anyURI
property_value: taxon_notes "in ruminants, this is" xsd:string
property_value: taxon_notes "Rodents have a single cotyledon (called a discoid placenta), whereas humans have multiple cotyledons, although they are consolidated into a cluster that resembles a single disc[PMID:19829370]" xsd:string

