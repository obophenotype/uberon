relationship: part_of UBERON:8600038 ! placental disc
relationship: present_in_taxon NCBITaxon:9443 {xref="PMID:31002314"} ! Primates
property_value: dcterms-date "2023-09-14T08:19:13Z" xsd:dateTime

[Term]
id: UBERON:8600020
name: placental septum
def: "An extension of the basal plate that protrudes into the intervillous space, creating a system of grooves which delimit elevated areas, also known as cotyledons or maternal lobes." [doi:10.1007/978-3-030-84725-8, PMID:32108320]
synonym: "placenta septum" EXACT [PMID:35190336]
synonym: "placental septa" RELATED OMO:0003004 [doi:10.1007/BF00406305]
