is_a: UBERON:0002616 ! regional part of brain
relationship: capable_of_part_of GO:0007613 {source="Wikipedia"} ! memory
relationship: in_taxon NCBITaxon:40674 {source="Wikipedia:Hippocampus"} ! Mammalia
relationship: mutually_spatially_disjoint_with UBERON:0001885 {source="ABA"} ! dentate gyrus of hippocampal formation
relationship: mutually_spatially_disjoint_with UBERON:0002601 {source="ABA"} ! fasciolar gyrus
