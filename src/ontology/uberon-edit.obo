xref: UMLS:C0262332 {source="ncithesaurus:Sulcus_Limitans"}
xref: Wikipedia:Sulcus_limitans
is_a: UBERON:0002553 ! anatomical cavity
relationship: part_of UBERON:0002422 ! fourth ventricle
property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/7/77/Gray709.png" xsd:anyURI

