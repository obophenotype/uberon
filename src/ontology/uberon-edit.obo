property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/3/36/Gray768.png" xsd:anyURI

[Term]
id: UBERON:0005975
name: hair follicle bulge
def: "The area located in the bottom of the permanent portion of a resting (telogen) hair follicle where the cells of the external root sheath of the hair follicle are contiguous with the basal layer of the epidermis; this portion of the follicle is involved in the generation of a new hair at the onset of the hair growth cycle (anagen) and contains the hair follicle stem cells." [MP:0009759]
subset: pheno_slim
synonym: "bulge" NARROW [DOI:10.1016/j.cub.2008.12.005]
synonym: "bulge of hair follicle" EXACT [FMA:70735]
