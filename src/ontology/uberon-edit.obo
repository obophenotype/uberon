[Term]
id: UBERON:0005366
name: olfactory lobe
def: "The lobe at the anterior part of each cerebral hemisphere, responsible for olfactory functions." [UBERON:cjm]
subset: efo_slim
subset: pheno_slim
xref: BTO:0001362
xref: EFO:0000108
xref: EHDAA2_RETIRED:0001294
