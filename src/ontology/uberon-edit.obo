id: UBERON:0010078
name: optic choroid vascular plexus
synonym: "capillary lamina of choroid" RELATED [XAO:0004176]
synonym: "choriocapillaris" RELATED [XAO:0004176]
synonym: "choroid vascular plexus" RELATED []
synonym: "choroid vasculature" RELATED [ZFA:0005094]
