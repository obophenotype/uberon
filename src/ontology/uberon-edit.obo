is_a: UBERON:0000062 ! organ
disjoint_from: UBERON:0010264 ! hepatopancreas
relationship: has_developmental_contribution_from UBERON:0003922 ! pancreatic epithelial bud
relationship: has_developmental_contribution_from UBERON:0003923 {source="Wikipedia"} ! dorsal pancreatic bud
