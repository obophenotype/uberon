relationship: part_of UBERON:0002486 ! glottis
property_value: curator_notes "The posterior commissure of larynx is in reality a misnomer; the vocal folds never join at their posterior ends, and the posterior aspect of the glottis is in reality a collapsible wall." xsd:string {xref="PMID:25272366"}
property_value: dcterms-date "2022-12-07T08:52:45Z" xsd:dateTime

