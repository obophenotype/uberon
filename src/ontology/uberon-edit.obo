relationship: has_potential_to_develop_into UBERON:0003126 ! trachea
relationship: part_of UBERON:0000922 ! embryo
relationship: part_of UBERON:0001041 {source="EHDAA2"} ! foregut
relationship: part_of UBERON:0001558 {source="EHDAA2"} ! lower respiratory tract
property_value: editor_note "Note we currently have pharynx as part of the upper respiratory tract - separate by development?" xsd:string
property_value: homology_notes "Lung development begins with the appearance of the laryngotracheal groove, which is a small diverticulum that arises from the floor of the primitive pharynx at E9 in mouse and 4 wk in human.[well established][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0001404", ontology="VHOG", source="PMID:15817505 Warburton D, Bellusci S, De Langhe S, Del Moral PM, Fleury V, Mailleux A, Tefft D, Unbekandt M, Wang K, Shi W, Molecular mechanisms of early lung specification and branching morphogenesis. Pediatric Research (2005)", source="http://bgee.unil.ch/"}

