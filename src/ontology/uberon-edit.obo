disjoint_from: UBERON:0009985 {source="lexical"} ! lateral condyle of femur
relationship: part_of UBERON:0004406 {source="FMA"} ! distal epiphysis of femur
property_value: depiction "http://upload.wikimedia.org/wikipedia/commons/5/53/Gray246.png" xsd:anyURI

[Term]
