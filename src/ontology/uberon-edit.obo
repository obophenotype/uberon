property_value: external_definition "A system of communicating epithelial sacs and ducts within the bony labyrinth, containing the endolymph. [TFD][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000729", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/membranous+labyrinth"}
