intersection_of: proximally_connected_to UBERON:0003221 ! phalanx
relationship: distally_connected_to UBERON:0004300 ! distal phalanx
relationship: distally_connected_to UBERON:0004300 {gci_filler="NCBITaxon:314146", gci_relation="part_of", notes="human and mouse"} ! distal phalanx
relationship: proximally_connected_to UBERON:0004302 ! proximal phalanx
relationship: proximally_connected_to UBERON:0004302 {gci_filler="NCBITaxon:314146", gci_relation="part_of", notes="human and mouse"} ! proximal phalanx
property_value: editor_note "consider using numbering system, and axioms to the effect that there is a single middle phalanx per finger in humans. This should perhaps be renamed 'intermediate phalanx', leaving the term middle phalanx open for the specific intermediate phalanx of a 3-phalanx digit" xsd:string
property_value: taxon_notes "in some groups such as whales, there are multiple intermediate phalanges" xsd:string
property_value: taxon_notes "Intermediate phalanges are bones found in the limbs of most vertebrates. In humans, they are the bones of the finger and toe which lie in the middle, between the two wrinkly joints. The thumb and big toe do not have intermediate phalanges. In most other vertebrates, they have a corresponding place in their limbs, whether they be paw, wing, hoof or fin" xsd:string {source="WP"}

[Term]
id: UBERON:0004302
name: proximal phalanx
def: "Proximal-most phalanx within a digit." [http://orcid.org/0000-0002-6601-2165]
synonym: "phalanx 1" EXACT []
synonym: "phalanx I" EXACT []
