xref: BIRNLEX:1731
xref: FMA:68596
xref: NCIT:C94868
xref: neuronames:1032 {source="tgbugs"}
xref: SCTID:384717008
xref: Wikipedia:Brodmann_area
xref: WikipediaCategory:Brodmann_areas
