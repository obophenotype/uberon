relationship: connects UBERON:0002529 {cardinality="2"} ! limb segment

[Term]
id: UBERON:0010861
name: propatagium
def: "In bats and pterosaurs, thin web of skin that extends from the shoulder to the wrist anterior to the upper arm and forearm, and is fixed on the neck or skull." [http://palaeos.com/vertebrates/glossary/glossaryPo.html]
is_a: UBERON:0010858 ! inter limb-segment region
relationship: part_of UBERON:0010856 ! patagium
property_value: taxon_notes "In bats: The patagium present from the neck to the first digit" xsd:string {source="Wikipedia:Patagium"}
property_value: taxon_notes "In birds: The triangular fold of skin on leading edge of the wing" xsd:string {source="http://caiquesite.com/glossary.htm"}
property_value: taxon_notes "In pterosaurs: the patagium present from the shoulder to the wrist" xsd:string {source="Wikipedia:Patagium"}

