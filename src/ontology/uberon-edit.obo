synonym: "bct" EXACT [MBA:490]
xref: MBA:490
is_a: UBERON:0001018 ! axon tract

[Term]
id: UBERON:8440035
name: sublaterodorsal nucleus
def: "A region in the dorsal pons that plays a central role in inducing motor suppression during REM sleep." [PMID:31679942]
synonym: "SLD" EXACT [MBA:358]
synonym: "sublaterodorsal tegmental nucleus" EXACT []
xref: MBA:358
is_a: UBERON:0002308 ! nucleus of brain
relationship: part_of UBERON:0000988 ! pons

[Term]
id: UBERON:8440036
name: supratrigeminal nucleus
def: "A premotoneuron pool in the trigeminal reflex arc that is a key structure of jaw movement control." [PMID:26987956]
synonym: "SUT" EXACT [MBA:534]
synonym: "Vsup" EXACT [PMID:26987956]
