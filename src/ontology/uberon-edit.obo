property_value: editor_note "in future this may be merged into a more species-neutral class" xsd:string

[Term]
id: UBERON:0009559
name: metacarpal/tarsal-phalangeal joint
def: "A skeletal joint that connects a mesopodium bone and connects a proximal phalanx." [OBOL:automatic]
synonym: "fetlock" NARROW SENSU [https://orcid.org/0000-0002-6601-2165, NCBITaxon:9788, Wikipedia:Fetlock]
synonym: "metacarpo-tarsophalangeal joint" EXACT [https://orcid.org/0000-0002-6601-2165]
synonym: "metapodial-phalangeal joint" EXACT [https://orcid.org/0000-0002-6601-2165]
synonym: "metapodium-phalanx joint" EXACT [https://orcid.org/0000-0002-6601-2165]
