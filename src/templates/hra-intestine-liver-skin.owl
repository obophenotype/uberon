# Class: obo:UBERON_8930102 (omental taenia coli)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:978-1496398949") Annotation(oboInOwl:hasDbXref "PMID:29218384") Annotation(oboInOwl:hasDbXref "PMID:30324463") Annotation(oboInOwl:hasDbXref "https://purl.org/ccf/ASCTB-TEMP_omental-coli") obo:IAO_0000115 obo:UBERON_8930102 "An organ component layer composed primarily of smooth muscle that forms one of the three longitudinal ribbons (taeniae) of the colon musculature, situated posterolaterally in the cecum, ascending colon, descending colon, and sigmoid colon, and on the anterosuperior surface of the transverse colon where layers three and four of the greater omentum meet the transverse colon.")
AnnotationAssertion(obo:RO_0002175 obo:UBERON_8930102 obo:NCBITaxon_9606)
